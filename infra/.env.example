# Copy to .env and fill in. Then: docker compose --env-file .env up -d

# The domain people reach the server at (DNS must point here for automatic HTTPS).
# `localhost` works for trying it out (Caddy then uses its own local CA).
DOMAIN=notes.example.com

# Who can create accounts: open, invite (default), or disabled.
SIGNUP=invite

# Secrets: use long random values (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me

# Only with docker-compose.s3.yml (attachments in S3 rather than a volume):
# S3_ACCESS_KEY_ID=workspace
# S3_SECRET_ACCESS_KEY=change-me-too
# S3_BUCKET=workspace-files
# S3_ENDPOINT=http://seaweedfs:8333   # or your MinIO / S3 endpoint

# Single sign-on with OpenID Connect (GitLab, Google, Keycloak, Authentik...). For each
# provider, register https://$DOMAIN/api/auth/oidc/<id>/callback as its redirect URI.
# OIDC_PROVIDERS=gitlab
# OIDC_GITLAB_ISSUER=https://gitlab.com
# OIDC_GITLAB_CLIENT_ID=...
# OIDC_GITLAB_CLIENT_SECRET=...
# OIDC_GITLAB_NAME=GitLab

# Email (optional): workspace invites, and digests of unread notifications (each person
# chooses: after a mention, daily, or never). Without it, whoever invites someone copies the
# invite link and sends it themselves, and nobody gets digests.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=Workspace <notes@example.com>

# Webhooks (from automations, buttons and integrations) go only to public https addresses. To let them reach this
# server's own network (an internal service), or plain http, allow it here.
# WEBHOOK_ALLOW_PRIVATE=true
# WEBHOOK_ALLOW_HTTP=true

# Optional
MAX_FILE_MB=512
LOG_LEVEL=info
